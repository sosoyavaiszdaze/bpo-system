# ============================================
# BPO System 環境変数テンプレート
# コピーして .env を作成: cp .env.example .env
#
# 命名規約: <SERVICE>_<KEY>_<CLIENT_ID_UPPERCASE>
# 詳細: docs/client_management.md
# ============================================

# ── 共通 (全クライアント共通) ────────────────

# Twenty CRM
TWENTY_API_URL=
TWENTY_API_KEY=

# Google Ads (共通認証情報)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# Slack (Fraud判断フロー用)
SLACK_FRAUD_JUDGMENT_WEBHOOK=

# ── クライアント別 ──────────────────────────
# 以下は yamamoto_demo クライアントの例
# 新規クライアント追加時は CLIENT_ID 部分を変更

# Meta Ads
META_ACCESS_TOKEN_YAMAMOTO_DEMO=

# TikTok Ads
TIKTOK_ACCESS_TOKEN_YAMAMOTO_DEMO=

# Slack Webhook
SLACK_WEBHOOK_YAMAMOTO_DEMO=

# AdTruth
ADTRUTH_API_KEY_YAMAMOTO_DEMO=
