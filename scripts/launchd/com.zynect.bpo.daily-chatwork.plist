<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BPO System 日次 ChatWork ジョブ (ADR-005 / Phase A 本番化済 5/8)

  実行: 毎日 09:00 / 09:15 / 09:30 JST の 3 連射 (Option C)
  内容: scripts/daily_chatwork_check.py --client pilotton
  本番投稿モード (5/8 09:00〜): クライアントに直接届く正式投稿
  内部レビュー期間中の試験投稿モードは 5/7 で完了。

  3 連射の根拠 (Option C):
    - chatwork_sent.json の sha256(room_id|body) 冪等性により、
      同日同状態の 2 回目以降は {"skipped": True} で副作用なし
    - 09:00 が Mac 起動直後/スリープ復帰直後で失敗した場合、
      09:15 / 09:30 の再試行で確実に 1 回送信を保証
    - 失敗時の launchd 再試行 (Status≠0 → 10 秒後) と独立した安全網

  本番化時の再登録手順 (5/7 夜 / 5/8 09:00 launchd 実行前 必須):
    1. cp scripts/launchd/com.zynect.bpo.daily-chatwork.plist \
            ~/Library/LaunchAgents/com.zynect.bpo.daily-chatwork.plist
    2. launchctl bootout  gui/$(id -u)/com.zynect.bpo.daily-chatwork  # 旧 plist 解除
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zynect.bpo.daily-chatwork.plist
    4. launchctl print    gui/$(id -u)/com.zynect.bpo.daily-chatwork  # 状態確認
       state=not running、event triggers が 9:00/9:15/9:30 の 3 件であることを確認

  状態確認: launchctl print gui/$(id -u)/com.zynect.bpo.daily-chatwork
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zynect.bpo.daily-chatwork</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/trunktrunk/bpo-system/bpo-system/venv/bin/python3</string>
        <string>/Users/trunktrunk/bpo-system/bpo-system/scripts/daily_chatwork_check.py</string>
        <string>--client</string>
        <string>pilotton</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/trunktrunk/bpo-system/bpo-system</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key>
        <string>Asia/Tokyo</string>
        <key>LANG</key>
        <string>ja_JP.UTF-8</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/trunktrunk/bpo-system/bpo-system/logs/daily-chatwork.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/trunktrunk/bpo-system/bpo-system/logs/daily-chatwork.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
